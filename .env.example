# Optional: connect a Supabase project so signing in needs no setup.
# Copy to .env.local for local development, or set these as GitHub repository
# variables so the deployed build picks them up.
#
# Leave them unset and lock.in stays entirely local — no account, no cloud.
#
# The anon key is public by design: it can only do what row-level security
# allows, which is "read and write your own row". Never put the service_role
# key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
